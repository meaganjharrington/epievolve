geom_hline(yintercept = 1, linetype = 2, color = "black", linewidth = 0.7) +
geom_vline(xintercept = c(100, 180, 240), linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
scale_fill_manual(values  = c("EpiEstim" = "#E69F00", "rodent" = "#0072B2")) +
scale_color_manual(values = c("EpiEstim" = "#E69F00", "rodent" = "#0072B2")) +
labs(x = "Time (days)", y = "Estimated Rt",
title    = "Ebola Sierra Leone 2014 — rodent vs EpiEstim: Block Rt Comparison",
subtitle = "SI: mean = 14.2 days, sd = 9.6 days (WHO Ebola Team, NEJM 2014)",
fill = "Method", color = "Method") +
theme_minimal(base_size = 13) +
theme(legend.position = "bottom")
print(p6_comparison)
cat("\n===== EBOLA SIERRA LEONE — Rt COMPARISON =====\n\n")
for (i in seq_len(nrow(df_epiestim_blocks))) {
cat(sprintf("Block %d (days %d-%d):\n", i,
df_epiestim_blocks$t_start[i], df_epiestim_blocks$t_end[i]))
cat(sprintf("  EpiEstim : %.2f [%.2f, %.2f]\n",
df_epiestim_blocks$Mean[i],
df_epiestim_blocks$Lower[i],
df_epiestim_blocks$Upper[i]))
cat(sprintf("  rodent   : %.2f [%.2f, %.2f]\n\n",
df_rodent_blocks_fmt$Mean[i],
df_rodent_blocks_fmt$Lower[i],
df_rodent_blocks_fmt$Upper[i]))
}
