knitr::kable(
sup3_table,
caption = "Supplementary Table 3. Sensitivity of Rt recovery to misspecified prior mean for the initial number of infected individuals (I₀) in Scenario 1. Coverage = proportion of days where true Rt lies within model-estimated 95% credible interval."
)
sup3 <- ggplot() +
geom_ribbon(data = I0_df,
aes(x = time, ymin = lwr, ymax = upr, fill = misspec),
alpha = 0.25) +
geom_line(data = I0_df,
aes(x = time, y = median, colour = misspec), linewidth = 0.85) +
geom_line(data = true_df_s1, aes(x = time, y = Rt),
colour = "black", linetype = "dashed", linewidth = 0.9) +
geom_hline(yintercept = 1, linetype = "dotted", colour = "red", linewidth = 0.6) +
geom_vline(xintercept = s1$vlines, linetype = "dotted",
colour = "darkgrey", linewidth = 0.55) +
scale_fill_manual(values = I0_cols, name = "Prior mean (I0)") +
scale_colour_manual(values = I0_cols, name = "Prior mean (I0)") +
labs(title    = "Supplementary Figure 3. I0 prior mean misspecification — S1 (N = 5,000)",
subtitle = "Tests robustness to uncertain seed size",
x = "Time (days)", y = expression(R[t])) +
theme_thesis
print(sup3)
sup3_table <- bind_rows(I0_stats)
knitr::kable(
sup3_table,
caption = "Supplementary Table 3. Sensitivity of Rt recovery to misspecified prior mean for the initial number of infected individuals (I₀) in Scenario 1. Coverage = proportion of days where true Rt lies within model-estimated 95% credible interval."
)
# If re-enabled:
# save_fig(sup2, "supp_fig2_beta_misspec.png", w = 8, h = 6)
save_fig(sup3, "supp_fig3_I0_misspec.png",   w = 8, h = 6)
sup2 <- ggplot() +
geom_ribbon(data = bm_df,
aes(x = time, ymin = lwr, ymax = upr, fill = misspec),
alpha = 0.25) +
geom_line(data = bm_df,
aes(x = time, y = median, colour = misspec), linewidth = 0.85) +
geom_line(data = true_df_s2, aes(x = time, y = Rt),
colour = "black", linetype = "dashed", linewidth = 0.9) +
geom_hline(yintercept = 1, linetype = "dotted", colour = "red", linewidth = 0.6) +
geom_vline(xintercept = s2$vlines, linetype = "dotted",
colour = "darkgrey", linewidth = 0.55) +
scale_fill_manual(values = bm_cols, name = "Prior mean (β)") +
scale_colour_manual(values = bm_cols, name = "Prior mean (β)") +
labs(title    = "Supplementary Figure 2. Beta prior mean misspecification — S2 (N = 100,000)",
subtitle = "Tests robustness to unknown true β with fixed I0",
x = "Time (days)", y = expression(R[t])) +
theme_thesis
print(sup2)
sup2_table <- bind_rows(bm_stats)
knitr::kable(
sup2_table,
caption = "Supplementary Table 2. Sensitivity of Rt recovery to mis-specified β prior mean in Scenario 2 (COVID-like). Fixed I0 throughout."
)
# If re-enabled:
save_fig(sup2, "supp_fig2_beta_misspec.png", w = 8, h = 6)
