color = "darkgrey", linewidth = 0.7) +
labs(title    = "Ebola Sierra Leone 2014 — EpiEstim: Rt (7-day Sliding Windows)",
subtitle = "SI: mean = 14.2 days, sd = 9.6 days (WHO Ebola Team, NEJM 2014)")
