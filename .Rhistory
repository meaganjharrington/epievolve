print(p5_epiestim_blocks)
# ---- 4) COMPARISON PLOT ----
df_epiestim_blocks <- res_blocks$R %>%
transmute(t_start = t_start, t_end = t_end,
Mean  = `Mean(R)`,
Lower = `Quantile.0.025(R)`,
Upper = `Quantile.0.975(R)`,
method = "EpiEstim")
df_rodent_blocks_fmt <- df_block_R %>%
transmute(t_start, t_end, Mean, Lower, Upper, method = "rodent")
df_combined <- bind_rows(df_epiestim_blocks, df_rodent_blocks_fmt) %>%
mutate(
x_start = ifelse(method == "rodent", t_start + 2, t_start - 2),
x_end   = ifelse(method == "rodent", t_end   + 2, t_end   - 2)
)
p6_comparison <- ggplot(df_combined) +
geom_rect(aes(xmin = x_start, xmax = x_end,
