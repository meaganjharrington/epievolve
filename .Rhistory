bm_cols <- setNames(sapply(beta_misspec, `[[`, "col"),
sapply(beta_misspec, `[[`, "label"))
sup2 <- ggplot() +
geom_ribbon(data = bm_df,
aes(x = time, ymin = lwr, ymax = upr, fill = misspec),
alpha = 0.25) +
geom_line(data = bm_df,
aes(x = time, y = median, colour = misspec), linewidth = 0.85) +
geom_line(data = true_df_s2, aes(x = time, y = Rt),
colour = "black", linetype = "dashed", linewidth = 0.9) +
geom_hline(yintercept = 1, linetype = "dotted", colour = "red", linewidth = 0.6) +
geom_vline(xintercept = s2$vlines, linetype = "dotted",
colour = "darkgrey", linewidth = 0.55) +
scale_fill_manual(values = bm_cols, name = "Prior mean (\u03b2)") +
scale_colour_manual(values = bm_cols, name = "Prior mean (\u03b2)") +
labs(title    = "Supplementary Figure 2. \u03b2 prior mean misspecification — S2 (N = 100,000)",
subtitle = "Fixed I\u2080  |  Tests robustness to unknown true \u03b2",
x = "Time (days)", y = expression(R[t])) +
theme_thesis
print(sup2)
# ============================================================
# SUP 3: I0 MISSPECIFICATION (S1)
# ============================================================
cat("Sup 3: I0 misspecification (S1)...\n")
I0_misspec <- list(
list(label = "Low (log(2))",    mean_I0 = log(2),  col = "#D55E00"),
list(label = "Truth (log(10))", mean_I0 = log(10), col = "#009E73"),
list(label = "High (log(50))",  mean_I0 = log(50), col = "#CC79A7")
)
I0_runs  <- list()
I0_stats <- list()
for (m in I0_misspec) {
fit <- fit_scenario(sim1$incidence_df, s1$N, s1$gamma, s1$beta_breaks,
s1$mean_beta, mean_I0 = m$mean_I0, sd_I0 = 0.5)
I0_runs[[m$label]]  <- fit$Rt_quantiles |> mutate(misspec = m$label)
I0_stats[[m$label]] <- coverage_stats(
Rt_true_s1, fit$Rt_quantiles$lwr, fit$Rt_quantiles$upr,
fit$Rt_quantiles$median, "S1", m$label)
}
I0_df   <- bind_rows(I0_runs)
I0_cols <- setNames(sapply(I0_misspec, `[[`, "col"),
sapply(I0_misspec, `[[`, "label"))
sup3 <- ggplot() +
geom_ribbon(data = I0_df,
aes(x = time, ymin = lwr, ymax = upr, fill = misspec),
alpha = 0.25) +
geom_line(data = I0_df,
aes(x = time, y = median, colour = misspec), linewidth = 0.85) +
geom_line(data = true_df_s1, aes(x = time, y = Rt),
colour = "black", linetype = "dashed", linewidth = 0.9) +
geom_hline(yintercept = 1, linetype = "dotted", colour = "red", linewidth = 0.6) +
geom_vline(xintercept = s1$vlines, linetype = "dotted",
colour = "darkgrey", linewidth = 0.55) +
scale_fill_manual(values = I0_cols, name = "Prior mean (I\u2080)") +
scale_colour_manual(values = I0_cols, name = "Prior mean (I\u2080)") +
labs(title    = "Supplementary Figure 3. I\u2080 prior mean misspecification — S1 (N = 5,000)",
subtitle = "Joint I\u2080 inference  |  Tests robustness to uncertain seed size",
x = "Time (days)", y = expression(R[t])) +
theme_thesis
print(sup3)
# ============================================================
# SUP 4: CHANGE-POINT TIMING SENSITIVITY (S2, N=10,000)
# ============================================================
cat("Sup 4: Change-point sensitivity (S2 profile, N=10,000)...\n")
N_cp  <- 10000
I0_cp <- max(1L, round(s2$I0 * (N_cp / s2$N)))
sim_cp <- simulate_epidemic(N_cp, s2$gamma, I0_cp,
s2$beta_values, s2$beta_times)
Rt_true_cp <- compute_true_Rt(s2$beta_values, s2$beta_times,
s2$gamma, sim_cp$S_true, N_cp)
true_df_cp <- data.frame(time = 1:150, Rt = Rt_true_cp)
cp_variants <- list(
list(label = "Correct",     breaks = s2$beta_breaks,          col = "#009E73"),
list(label = "Early (-7d)", breaks = pmax(1, s2$beta_breaks - 7), col = "#E69F00"),
list(label = "Late (+7d)",  breaks = s2$beta_breaks + 7,      col = "#56B4E9")
)
cp_runs  <- list()
cp_stats <- list()
for (cpv in cp_variants) {
fit <- fit_scenario(sim_cp$incidence_df, N_cp, s2$gamma, cpv$breaks,
s2$mean_beta, mean_I0 = log(I0_cp), sd_I0 = 0.5)
cp_runs[[cpv$label]]  <- fit$Rt_quantiles |> mutate(schedule = cpv$label)
cp_stats[[cpv$label]] <- coverage_stats(
Rt_true_cp, fit$Rt_quantiles$lwr, fit$Rt_quantiles$upr,
fit$Rt_quantiles$median, "S2 N=10k", cpv$label)
}
cp_df   <- bind_rows(cp_runs)
cp_cols <- setNames(sapply(cp_variants, `[[`, "col"),
sapply(cp_variants, `[[`, "label"))
sup4 <- ggplot() +
geom_ribbon(data = cp_df,
aes(x = time, ymin = lwr, ymax = upr, fill = schedule),
alpha = 0.25) +
geom_line(data = cp_df,
aes(x = time, y = median, colour = schedule), linewidth = 0.85) +
geom_line(data = true_df_cp, aes(x = time, y = Rt),
colour = "black", linetype = "dashed", linewidth = 0.9) +
geom_hline(yintercept = 1, linetype = "dotted", colour = "red", linewidth = 0.6) +
geom_vline(xintercept = s2$vlines, linetype = "dotted",
colour = "darkgrey", linewidth = 0.55) +
scale_fill_manual(values = cp_cols, name = "Break schedule") +
scale_colour_manual(values = cp_cols, name = "Break schedule") +
labs(title    = "Change-point timing sensitivity (N = 10,000)",
subtitle = "True change-point at day 45  |  Black dashed = true Rt",
x = "Time (days)", y = expression(R[t])) +
theme_thesis
print(sup4)
cat("\n--- Sup Table: CP sensitivity ---\n")
print(knitr::kable(bind_rows(cp_stats)))
# ============================================================
# SUP 5: CONVERGENCE DIAGNOSTICS (S1)
# ============================================================
cat("Sup 5: Convergence diagnostics (S1)...\n")
samp_arr  <- out_s1$samples$pars
par_names <- dimnames(samp_arr)[[1]]
if (is.null(par_names))
par_names <- c(sprintf("beta_%d", seq_len(dim(samp_arr)[1] - 1)), "I0")
n_pars   <- dim(samp_arr)[1]
n_steps  <- dim(samp_arr)[2]
n_chains <- dim(samp_arr)[3]
trace_df <- do.call(rbind, lapply(seq_len(n_chains), function(ch) {
do.call(rbind, lapply(seq_len(n_pars), function(p) {
data.frame(step  = seq_len(n_steps),
value = samp_arr[p, , ch],
param = par_names[p],
chain = factor(ch))
}))
}))
p_trace <- ggplot(trace_df, aes(x = step, y = value, colour = chain)) +
geom_line(alpha = 0.6, linewidth = 0.35) +
facet_wrap(~ param, scales = "free_y", ncol = 2) +
scale_colour_manual(values = c("#0072B2", "#E69F00", "#009E73"),
name = "Chain") +
labs(title    = "Trace plots — S1 (N = 5,000)",
subtitle = "Post-burnin samples  |  Overlapping chains indicate good mixing",
x = "Post-burnin iteration", y = "Value") +
theme_thesis + theme(strip.text = element_text(size = 8))
mcmc_list <- coda::mcmc.list(
lapply(seq_len(n_chains), function(ch) {
mat <- t(samp_arr[, , ch])
colnames(mat) <- par_names
coda::mcmc(mat)
})
)
rhat_vals <- coda::gelman.diag(mcmc_list, multivariate = FALSE)$psrf
ess_vals  <- coda::effectiveSize(mcmc_list)
diag_df <- data.frame(
Parameter   = par_names,
R_hat       = round(rhat_vals[, 1], 3),
R_hat_upper = round(rhat_vals[, 2], 3),
ESS         = round(ess_vals, 0)
)
p_rhat <- ggplot(diag_df, aes(x = reorder(Parameter, R_hat), y = R_hat)) +
geom_col(aes(fill = R_hat < 1.05), width = 0.6) +
geom_errorbar(aes(ymin = R_hat, ymax = R_hat_upper), width = 0.2) +
geom_hline(yintercept = 1.01, linetype = "dashed",
colour = "red", linewidth = 0.7) +
scale_fill_manual(values = c("TRUE" = "#009E73", "FALSE" = "#D55E00"),
labels = c("TRUE" = "< 1.05", "FALSE" = "\u2265 1.05"),
name = expression(hat(R))) +
coord_flip() +
labs(title    = expression(paste(hat(R), " convergence")),
subtitle = "Red = 1.01 target",
x = NULL, y = expression(hat(R))) +
theme_thesis
p_ess <- ggplot(diag_df, aes(x = reorder(Parameter, ESS), y = ESS)) +
geom_col(aes(fill = ESS > 400), width = 0.6) +
geom_hline(yintercept = 400, linetype = "dashed",
colour = "red", linewidth = 0.7) +
scale_fill_manual(values = c("TRUE" = "#009E73", "FALSE" = "#D55E00"),
labels = c("TRUE" = "> 400", "FALSE" = "\u2264 400"),
name = "ESS") +
coord_flip() +
labs(title    = "Effective sample size",
subtitle = "Red = 400 minimum",
x = NULL, y = "ESS") +
theme_thesis
sup5 <- (p_trace / (p_rhat | p_ess)) +
plot_annotation(
title    = "Supplementary Figure 5. MCMC convergence diagnostics — S1 (N = 5,000)",
subtitle = "Top: trace plots across 3 chains  |  Bottom left: R-hat  |  Bottom right: ESS",
theme    = theme(plot.title    = element_text(size = 12, face = "bold"),
plot.subtitle = element_text(size = 9, colour = "grey40"))
)
print(sup5)
cat("\n========== Convergence diagnostics table ==========\n")
print(knitr::kable(diag_df,
caption = "Supplementary Table. MCMC convergence diagnostics for S1. R-hat < 1.01 indicates good convergence; ESS > 400 is practically sufficient.",
col.names = c("Parameter", "R-hat", "R-hat upper CI", "ESS")))
cat("\n\n All figures and tables complete.\n")
cat("Figures: fig1-fig13, sup1-sup5\n")
cat("Tables:  table1 (coverage), table2 (flu blocks), table3 (ebola blocks), table4 (cov vs N)\n")
# ============================================================
# SUPPLEMENTARY FIGURE 6: PROFILE LIKELIHOOD SURFACES
# ============================================================
cat("Profile likelihood surfaces (S1 vs Ebola)")
# --- EBOLA ---
beta1_med    <- median(out_ebola$samples$pars["beta_1",,])
beta2_med    <- median(out_ebola$samples$pars["beta_2",,])
beta3_med    <- median(out_ebola$samples$pars["beta_3",,])
beta4_med    <- median(out_ebola$samples$pars["beta_4",,])
beta5_med    <- median(out_ebola$samples$pars["beta_5",,])
I0_med_ebola <- median(out_ebola$samples$pars["I0",,])
beta_grid_eb <- seq(beta2_med * 0.3, beta2_med * 3, length.out = 40)
I0_grid_eb   <- seq(1, 200, length.out = 40)
ll_mat_eb    <- matrix(NA, 40, 40)
for (i in seq_along(beta_grid_eb)) {
for (j in seq_along(I0_grid_eb)) {
sim <- tryCatch(
simulate_epidemic(
N           = 6900000,
gamma       = 0.1,
I0          = I0_grid_eb[j],
beta_values = c(beta1_med, beta_grid_eb[i],
beta3_med, beta4_med, beta5_med),
beta_times  = c(0, 1, 100, 180, 240),
T           = nrow(ebola_daily)
),
error = function(e) NULL
)
if (!is.null(sim)) {
n <- min(length(sim$inc_true), nrow(ebola_daily))
ll_mat_eb[i, j] <- sum(dpois(
ebola_daily$cases[1:n],
lambda = pmax(sim$inc_true[1:n], 1e-10),
log = TRUE
))
}
}
}
df_eb         <- reshape2::melt(ll_mat_eb)
df_eb$beta    <- beta_grid_eb[df_eb$Var1]
df_eb$I0      <- I0_grid_eb[df_eb$Var2]
df_eb$ll_norm <- df_eb$value - max(df_eb$value, na.rm = TRUE)
p_profile_ebola <- ggplot(df_eb, aes(x = I0, y = beta, fill = ll_norm)) +
geom_tile() +
geom_contour(aes(z = ll_norm),
breaks = c(-2, -5, -10, -20, -50),
colour = "white", alpha = 0.7, linewidth = 0.4) +
scale_fill_viridis_c(
name = "Log-likelihood\n(relative to peak)",
limits = c(-100, 0), oob = scales::squish
) +
geom_point(aes(x = I0_med_ebola, y = beta2_med),
colour = "red", size = 3, shape = 18,
inherit.aes = FALSE) +
labs(
title    = "N = 6,900,000",
subtitle = "Red = posterior median",
x = "Initial infected (I₀)",
y = expression(beta[2] ~ "(days 1-99)")
) +
theme_thesis
# --- S1 ---
s1_pars   <- dimnames(out_s1$samples$pars)[[1]]
cat("S1 parameter names:", s1_pars, "\n")
# Assumes S1 has 4 betas (beta_1 phantom + 3 real blocks)
# Adjust if different
beta1_s1  <- median(out_s1$samples$pars[s1_pars[1],,])
beta2_s1  <- median(out_s1$samples$pars[s1_pars[2],,])
beta3_s1  <- median(out_s1$samples$pars[s1_pars[3],,])
beta4_s1  <- median(out_s1$samples$pars[s1_pars[4],,])
I0_med_s1 <- median(out_s1$samples$pars["I0",,])
beta_grid_s1 <- seq(beta2_s1 * 0.3, beta2_s1 * 3, length.out = 40)
I0_grid_s1   <- seq(1, 50, length.out = 40)
ll_mat_s1    <- matrix(NA, 40, 40)
for (i in seq_along(beta_grid_s1)) {
for (j in seq_along(I0_grid_s1)) {
sim <- tryCatch(
simulate_epidemic(
N           = 5000,
gamma       = 0.25,
I0          = I0_grid_s1[j],
beta_values = c(beta1_s1, beta_grid_s1[i], beta3_s1, beta4_s1),
beta_times  = out_s1$beta_times,
T           = nrow(sim1$incidence_df)
),
error = function(e) NULL
)
if (!is.null(sim)) {
n <- min(length(sim$inc_true), nrow(sim1$incidence_df))
ll_mat_s1[i, j] <- sum(dpois(
sim1$incidence_df$cases[1:n],
lambda = pmax(sim$inc_true[1:n], 1e-10),
log = TRUE
))
}
}
}
df_s1         <- reshape2::melt(ll_mat_s1)
df_s1$beta    <- beta_grid_s1[df_s1$Var1]
df_s1$I0      <- I0_grid_s1[df_s1$Var2]
df_s1$ll_norm <- df_s1$value - max(df_s1$value, na.rm = TRUE)
p_profile_s1 <- ggplot(df_s1, aes(x = I0, y = beta, fill = ll_norm)) +
geom_tile() +
geom_contour(aes(z = ll_norm),
breaks = c(-2, -5, -10, -20, -50),
colour = "white", alpha = 0.7, linewidth = 0.4) +
scale_fill_viridis_c(
name = "Log-likelihood\n(relative to peak)",
limits = c(-100, 0), oob = scales::squish
) +
geom_point(aes(x = I0_med_s1, y = beta2_s1),
colour = "red", size = 3, shape = 18,
inherit.aes = FALSE) +
labs(
title    = "S1: Gradual decline  |  N = 5,000",
subtitle = "Red = posterior median",
x = "Initial infected (I₀)",
y = expression(beta[2] ~ "(days 1-29)")
) +
theme_thesis
sup6 <- (p_profile_s1 | p_profile_ebola) +
plot_annotation(
title    = "Profile likelihood surfaces",
subtitle = "Left: S1 (N=5,000, strong depletion)  |  Right: Ebola (N=6,900,000, minimal depletion)",
theme    = theme(
plot.title    = element_text(size = 12, face = "bold"),
plot.subtitle = element_text(size = 9,  colour = "grey40")
)
)
print(sup6)
