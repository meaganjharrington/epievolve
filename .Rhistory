# ============================================================
# DATASET 3: EBOLA SIERRA LEONE 2014
# ============================================================
data(ebola_sierraleone_2014)
ebola_daily_incid <- ebola_sierraleone_2014 %>%
filter(!is.na(date_of_onset)) %>%
group_by(date_of_onset) %>%
summarise(cases = n(), .groups = "drop") %>%
arrange(date_of_onset) %>%
mutate(time = row_number()) %>%
select(time, cases) %>%
as.data.frame()
out_ebola <- estimate_Rt_draws(
incidence   = ebola_daily_incid,
N           = 8600000,
gamma       = 0.2,
beta_breaks = c(1, 100, 180, 240)
)
ebola_vlines <- c(100, 180, 240)
Tmax_ebola   <- nrow(ebola_daily_incid)
# Panel 1: incidence
p1_ebola <- ggplot(ebola_daily_incid, aes(x = time, y = cases)) +
geom_col(fill = "#56B4E9", alpha = 0.8) +
geom_vline(xintercept = ebola_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(x = "Time (days)", y = "Daily cases",
title = "Incidence",
subtitle = "N = 8,600,000") +
theme_minimal(base_size = 11)
# Panel 2: rodent smooth
p2_ebola <- out_ebola$Rt_plot +
geom_vline(xintercept = ebola_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(title = "rodent: Rt(t)",
subtitle = "Piecewise beta, 95% CI") +
theme_minimal(base_size = 11) +
scale_y_continuous(limits = c(0, 5))
# EpiEstim — both window lengths
ebola_epiestim <- ebola_daily_incid %>% rename(I = cases)
res_sliding_ebola_7d <- estimate_R(
incid  = ebola_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 14.2, std_si = 9.6,
t_start = seq(2, Tmax_ebola - 6),
t_end   = seq(2, Tmax_ebola - 6) + 6
))
)
res_sliding_ebola_14d <- estimate_R(
incid  = ebola_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 14.2, std_si = 9.6,
t_start = seq(2, Tmax_ebola - 13),
t_end   = seq(2, Tmax_ebola - 13) + 13
))
)
# Panel 3: EpiEstim 7-day (volatile)
p3_ebola <- plot(res_sliding_ebola_7d, "R") +
geom_hline(aes(yintercept = 1), linetype = 2, color = "red") +
geom_vline(xintercept = ebola_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(title = "EpiEstim: 7-day windows",
subtitle = "Window < SI mean — unstable estimates") +
theme_minimal(base_size = 11) +
scale_y_continuous(limits = c(0, 5))
# Panel 4 (NEW): EpiEstim 14-day (stable)
p4_ebola_14d <- plot(res_sliding_ebola_14d, "R") +
geom_hline(aes(yintercept = 1), linetype = 2, color = "red") +
geom_vline(xintercept = ebola_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(title = "EpiEstim: 14-day windows",
subtitle = "Window ≥ SI mean — stable estimates") +
theme_minimal(base_size = 11) +
scale_y_continuous(limits = c(0, 5))
# Block comparison (uses 7-day blocks, unchanged)
df_block_ebola <- block_Rt_from_draws(
R_draws = out_ebola$posterior_paths$R,
starts  = out_ebola$blocks$beta_starts,
ends    = out_ebola$blocks$beta_ends
)
res_blocks_ebola <- estimate_R(
incid  = ebola_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 14.2, std_si = 9.6,
t_start = c(2, 100, 180, 240),
t_end   = c(99, 179, 239, Tmax_ebola)
))
)
df_epi_ebola <- res_blocks_ebola$R %>%
transmute(t_start, t_end, Mean = `Mean(R)`,
Lower = `Quantile.0.025(R)`, Upper = `Quantile.0.975(R)`)
df_rod_ebola <- df_block_ebola %>%
transmute(t_start, t_end, Mean, Lower, Upper)
# Panel 5: block comparison
p5_ebola <- make_comparison_plot(df_epi_ebola, df_rod_ebola, ebola_vlines)
# Panel 6: S(t)
p6_ebola <- plot_S_trajectory(out_ebola, N = 8600000,
title_label = "Ebola Sierra Leone")
# ---- 2x3 GRID ----
grid_ebola <- (p1_ebola | p2_ebola | p3_ebola) /
(p4_ebola_14d | p5_ebola | p6_ebola) +
plot_annotation(
title    = "Ebola Sierra Leone 2014",
subtitle = "Top row: incidence, rodent Rt(t), EpiEstim 7-day (unstable) | Bottom row: EpiEstim 14-day (stable), block comparison, S(t)",
theme    = theme(
plot.title    = element_text(size = 15, face = "bold"),
plot.subtitle = element_text(size = 9,  color = "grey40")
)
)
print(grid_ebola)
