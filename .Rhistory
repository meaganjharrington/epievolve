fill = "#56B4E9", alpha = 0.3) +
geom_line(aes(y = median), colour = "#56B4E9", linewidth = 1.0) +
labs(x = "Time (days)", y = "S(t)",
title = "S(t) — Susceptible trajectory",
subtitle = paste0("Posterior median ± 95% CI, N = ",
format(N, big.mark = ","))) +
theme_minimal(base_size = 11)
}
make_comparison_plot <- function(df_epi, df_rod, vlines = NULL) {
df_combined <- bind_rows(
df_epi %>% mutate(method = "EpiEstim"),
df_rod %>% mutate(method = "rodent")
) %>%
mutate(
x_start = ifelse(method == "rodent", t_start + 0.02 * (max(t_end) - min(t_start)),
t_start - 0.02 * (max(t_end) - min(t_start))),
x_end   = ifelse(method == "rodent", t_end   + 0.02 * (max(t_end) - min(t_start)),
t_end   - 0.02 * (max(t_end) - min(t_start)))
)
p <- ggplot(df_combined) +
geom_rect(aes(xmin = x_start, xmax = x_end,
ymin = Lower, ymax = Upper, fill = method),
alpha = 0.3, color = NA) +
geom_segment(aes(x = x_start, xend = x_end,
y = Mean, yend = Mean, color = method),
linewidth = 1.1) +
geom_hline(yintercept = 1, linetype = 2, color = "black", linewidth = 0.6) +
scale_fill_manual(values  = c("EpiEstim" = "#E69F00", "rodent" = "#0072B2")) +
scale_color_manual(values = c("EpiEstim" = "#E69F00", "rodent" = "#0072B2")) +
labs(x = "Time (days)", y = "Rt",
title = "Block Rt comparison",
subtitle = "Orange = EpiEstim, Blue = rodent",
fill = NULL, color = NULL) +
theme_minimal(base_size = 11) +
theme(legend.position = "bottom")
if (!is.null(vlines))
p <- p + geom_vline(xintercept = vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6)
p
}
make_grid <- function(p_incid, p_rodent, p_epiestim, p_compare, p_st,
dataset_label) {
(p_incid | p_rodent | p_epiestim) /
(p_compare | p_st | plot_spacer()) +
plot_annotation(
title = dataset_label,
theme = theme(plot.title = element_text(size = 15, face = "bold"))
)
}
# ============================================================
# DATASET 1: FLU 2009 H1N1
# ============================================================
data(Flu2009)
flu_daily_incid <- Flu2009$incidence %>%
mutate(time = row_number()) %>%
rename(cases = I) %>%
select(time, cases) %>%
as.data.frame()
out_flu <- estimate_Rt_draws(
incidence   = flu_daily_incid,
N           = 369,
gamma       = 1/2.6,
beta_breaks = c(1, 18, 25),
priors = list(mean_beta = log(0.5), sd_beta = 1.0,
rw_sd_beta = 0.3, mean_I0 = log(5), sd_I0 = 0.5),
inits = list(beta = 0.5, I0 = 5),
mcmc  = list(n_steps = 15000, burnin = 0.5,
proposal = diag(c(0.1, 0.1, 0.1, 0.15)),
seed = 444, n_rt_draws = 1000)
)
flu_vlines <- c(18, 25)
Tmax_flu   <- nrow(flu_daily_incid)
# Panel 1: incidence
p1_flu <- ggplot(flu_daily_incid, aes(x = time, y = cases)) +
geom_col(fill = "#56B4E9", alpha = 0.8) +
geom_vline(xintercept = flu_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
annotate("text", x = 19, y = max(flu_daily_incid$cases) * 0.9,
label = "closure", hjust = 0, size = 2.8, color = "darkgrey") +
labs(x = "Time (days)", y = "Daily cases",
title = "Incidence",
subtitle = "N = 369 (Cauchemez 2011)") +
theme_minimal(base_size = 11)
# Panel 2: rodent smooth
p2_flu <- out_flu$Rt_plot +
geom_vline(xintercept = flu_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(title = "rodent: Rt(t)",
subtitle = "Piecewise beta, 95% CI") +
theme_minimal(base_size = 11)
# Panel 3: EpiEstim sliding
flu_epiestim <- flu_daily_incid %>% rename(I = cases)
res_sliding_flu <- estimate_R(
incid  = flu_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 2.6, std_si = 1.5,
t_start = seq(2, Tmax_flu - 6),
t_end   = seq(2, Tmax_flu - 6) + 6
))
)
p3_flu <- plot(res_sliding_flu, "R") +
geom_hline(aes(yintercept = 1), linetype = 2, color = "red") +
geom_vline(xintercept = flu_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(title = "EpiEstim: sliding Rt",
subtitle = "7-day windows, SI mean=2.6d") +
theme_minimal(base_size = 11)
# Panel 4: blockwise comparison
df_block_flu <- block_Rt_from_draws(
R_draws = out_flu$posterior_paths$R,
starts  = out_flu$blocks$beta_starts,
ends    = out_flu$blocks$beta_ends
)
res_blocks_flu <- estimate_R(
incid  = flu_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 2.6, std_si = 1.5,
t_start = c(2, 18, 25), t_end = c(17, 24, Tmax_flu)
))
)
df_epi_flu <- res_blocks_flu$R %>%
transmute(t_start, t_end, Mean = `Mean(R)`,
Lower = `Quantile.0.025(R)`, Upper = `Quantile.0.975(R)`)
df_rod_flu <- df_block_flu %>%
transmute(t_start, t_end, Mean, Lower, Upper)
p4_flu <- make_comparison_plot(df_epi_flu, df_rod_flu, flu_vlines)
# Panel 5: S(t)
p5_flu <- plot_S_trajectory(out_flu, N = 369, title_label = "Flu 2009")
# Compose grid
grid_flu <- make_grid(p1_flu, p2_flu, p3_flu, p4_flu, p5_flu,
"Flu 2009 H1N1 — Pennsylvania School Outbreak")
print(grid_flu)
