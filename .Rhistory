t_start_sl <- seq(2, Tmax - 6)
t_end_sl   <- t_start_sl + 6
res_sliding <- estimate_R(
incid  = ebola_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 14.2, std_si = 9.6,
t_start = t_start_sl, t_end = t_end_sl
))
)
# PLOT 4: EpiEstim sliding
p4_epiestim_sliding <- plot(res_sliding, "R") +
geom_hline(aes(yintercept = 1), linetype = 2, color = "red") +
geom_vline(xintercept = c(100, 180, 240), linetype = "dotted",
color = "darkgrey", linewidth = 0.7) +
labs(title    = "Ebola Sierra Leone 2014 — EpiEstim: Rt (7-day Sliding Windows)",
subtitle = "SI: mean = 14.2 days, sd = 9.6 days (WHO Ebola Team, NEJM 2014)")
print(p4_epiestim_sliding)
# non-sliding windows
t_start_bl <- c(2, 100, 180, 240)
t_end_bl   <- c(99, 179, 239, Tmax)
res_blocks <- estimate_R(
incid  = ebola_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 14.2, std_si = 9.6,
t_start = t_start_bl, t_end = t_end_bl
))
)
# PLOT 5: EpiEstim blocks
p5_epiestim_blocks <- plot(res_blocks, "R") +
geom_hline(aes(yintercept = 1), linetype = 2, color = "red") +
labs(title    = "Ebola Sierra Leone 2014 — EpiEstim: Rt (Non-sliding Windows)",
subtitle = "SI: mean = 14.2 days, sd = 9.6 days (WHO Ebola Team, NEJM 2014)")
print(p5_epiestim_blocks)
# ---- 4) COMPARISON PLOT ----
df_epiestim_blocks <- res_blocks$R %>%
transmute(t_start = t_start, t_end = t_end,
Mean  = `Mean(R)`,
Lower = `Quantile.0.025(R)`,
Upper = `Quantile.0.975(R)`,
method = "EpiEstim")
df_rodent_blocks_fmt <- df_block_R %>%
transmute(t_start, t_end, Mean, Lower, Upper, method = "rodent")
df_combined <- bind_rows(df_epiestim_blocks, df_rodent_blocks_fmt) %>%
mutate(
x_start = ifelse(method == "rodent", t_start + 2, t_start - 2),
x_end   = ifelse(method == "rodent", t_end   + 2, t_end   - 2)
)
p6_comparison <- ggplot(df_combined) +
geom_rect(aes(xmin = x_start, xmax = x_end,
ymin = Lower,   ymax = Upper, fill = method),
alpha = 0.3, color = NA) +
geom_segment(aes(x = x_start, xend = x_end,
y = Mean, yend = Mean, color = method),
linewidth = 1.2) +
geom_hline(yintercept = 1, linetype = 2, color = "black", linewidth = 0.7) +
geom_vline(xintercept = c(100, 180, 240), linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
scale_fill_manual(values  = c("EpiEstim" = "#E69F00", "rodent" = "#0072B2")) +
scale_color_manual(values = c("EpiEstim" = "#E69F00", "rodent" = "#0072B2")) +
labs(x = "Time (days)", y = "Estimated Rt",
title    = "Ebola Sierra Leone 2014 — rodent vs EpiEstim: Block Rt Comparison",
subtitle = "SI: mean = 14.2 days, sd = 9.6 days (WHO Ebola Team, NEJM 2014)",
fill = "Method", color = "Method") +
theme_minimal(base_size = 13) +
theme(legend.position = "bottom")
print(p6_comparison)
cat("\n===== EBOLA SIERRA LEONE — Rt COMPARISON =====\n\n")
for (i in seq_len(nrow(df_epiestim_blocks))) {
cat(sprintf("Block %d (days %d-%d):\n", i,
df_epiestim_blocks$t_start[i], df_epiestim_blocks$t_end[i]))
cat(sprintf("  EpiEstim : %.2f [%.2f, %.2f]\n",
df_epiestim_blocks$Mean[i],
df_epiestim_blocks$Lower[i],
df_epiestim_blocks$Upper[i]))
cat(sprintf("  rodent   : %.2f [%.2f, %.2f]\n\n",
df_rodent_blocks_fmt$Mean[i],
df_rodent_blocks_fmt$Lower[i],
df_rodent_blocks_fmt$Upper[i]))
}
# Extra plots for S(t)
# SIR plots
plot_S_trajectory <- function(out, N, title_label = "") {
S_draws  <- out$posterior_paths$S
S_median <- apply(S_draws, 1, median)
S_lower  <- apply(S_draws, 1, quantile, 0.025)
S_upper  <- apply(S_draws, 1, quantile, 0.975)
time_vec <- out$Rt_series$time
df <- data.frame(
time   = time_vec,
median = S_median,
lower  = S_lower,
upper  = S_upper
)
# THIS PART WAS MISSING
ggplot(df, aes(x = time)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "#56B4E9", alpha = 0.3) +
geom_line(aes(y = median), colour = "#56B4E9", linewidth = 1.1) +
labs(
x        = "Time (days)",
y        = "S(t) — susceptible individuals",
title    = paste0(title_label, " — Posterior S(t)"),
subtitle = paste0("Posterior median and 95% credible interval, N = ",
format(N, big.mark = ","))
) +
theme_minimal(base_size = 13)
}
# Ebola (run after your ebola out object)
p_S_ebola <- plot_S_trajectory(out, N = 8600000,
title_label = "Ebola Sierra Leone 2014")
print(p_S_ebola)
plot_beta_trajectory <- function(out, title_label = "") {
beta_draws  <- out$posterior_paths$beta   # T x D matrix
beta_median <- apply(beta_draws, 1, median)
beta_lower  <- apply(beta_draws, 1, quantile, 0.025)
beta_upper  <- apply(beta_draws, 1, quantile, 0.975)
time_vec    <- out$Rt_series$time
df <- data.frame(
time   = time_vec,
median = beta_median,
lower  = beta_lower,
upper  = beta_upper
)
ggplot(df, aes(x = time)) +
geom_ribbon(aes(ymin = lower, ymax = upper),
fill = "#E69F00", alpha = 0.3) +
geom_line(aes(y = median), colour = "#E69F00", linewidth = 1.1) +
labs(
x        = "Time (days)",
y        = "β(t)",
title    = paste0(title_label, " — Posterior β(t)"),
subtitle = "Posterior median and 95% credible interval"
) +
theme_minimal(base_size = 13)
}
p_beta_ebola <- plot_beta_trajectory(out_ebola, "Ebola Sierra Leone 2014")
# ============================================================
# SCRIPT 3: EBOLA SIERRA LEONE 2014 — 6 plots
# 1) Incidence  2) rodent Rt(t)  3) rodent blocks
# 4) EpiEstim sliding  5) EpiEstim blocks  6) comparison
# ============================================================
rm(list = ls())
library(dust2); library(ggplot2); library(EpiEstim)
library(dplyr); library(outbreaks)
set.seed(444)
load_all()
# ---- 1) DATA ----
data(ebola_sierraleone_2014)
ebola_daily_incidence <- ebola_sierraleone_2014 %>%
filter(!is.na(date_of_onset)) %>%
group_by(date_of_onset) %>%
summarise(cases = n(), .groups = "drop") %>%
arrange(date_of_onset) %>%
mutate(time = row_number()) %>%
select(time, cases) %>%
as.data.frame()
cat("=== EBOLA SIERRA LEONE 2014 ===\n")
cat("Total cases:", sum(ebola_daily_incidence$cases), "\n")
cat("Peak daily cases:", max(ebola_daily_incidence$cases), "\n")
cat("Day of peak:", which.max(ebola_daily_incidence$cases), "\n")
cat("Total days:", nrow(ebola_daily_incidence), "\n\n")
# PLOT 1: incidence
p1_incidence <- ggplot(ebola_daily_incidence, aes(x = time, y = cases)) +
geom_col(fill = "#56B4E9", alpha = 0.8) +
geom_vline(xintercept = c(100, 180, 240), linetype = "dotted",
color = "darkgrey", linewidth = 0.7) +
annotate("text", x = c(101, 181, 241),
y = rep(max(ebola_daily_incidence$cases) * 0.95, 3),
label = c("P2", "P3", "P4"),
hjust = 0, size = 3, color = "darkgrey") +
labs(x = "Time (days)", y = "Daily cases",
title    = "Ebola Sierra Leone 2014 — Daily Incidence",
subtitle = "Date of symptom onset; N = 8,600,000") +
theme_minimal(base_size = 13)
print(p1_incidence)
# ---- 2) RODENT ----
out <- estimate_Rt_draws(
incidence   = ebola_daily_incidence,
N           = 8600000,
gamma       = 0.2,
beta_breaks = c(1, 100, 180, 240)
)
# PLOT 2: rodent Rt(t)
p2_rodent_rt <- out$Rt_plot +
geom_vline(xintercept = c(100, 180, 240), linetype = "dotted",
color = "darkgrey", linewidth = 0.7) +
labs(title    = "Ebola Sierra Leone 2014 — rodent: Time-varying Rt",
subtitle = "Mechanistic SIR, piecewise beta, 95% credible interval")
print(p2_rodent_rt)
# ---- rodent blocks ----
df_block_R <- block_Rt_from_draws(
R_draws = out$posterior_paths$R,
starts  = out$blocks$beta_starts,
ends    = out$blocks$beta_ends
)
# PLOT 3: rodent blocks
p3_rodent_blocks <- ggplot(df_block_R) +
geom_rect(aes(xmin = t_start, xmax = t_end, ymin = Lower, ymax = Upper),
fill = "#0072B2", alpha = 0.3, color = NA) +
geom_segment(aes(x = t_start, xend = t_end, y = Mean, yend = Mean),
linewidth = 1.2, color = "#0072B2") +
geom_hline(yintercept = 1, linetype = 2, color = "red", linewidth = 0.7) +
geom_vline(xintercept = c(100, 180, 240), linetype = "dotted",
color = "darkgrey", linewidth = 0.7) +
labs(x = "Time (days)", y = "Estimated Rt",
title    = "Ebola Sierra Leone 2014 — rodent: Block Rt Estimates",
subtitle = "Mean and 95% credible interval per block") +
theme_minimal(base_size = 13)
print(p3_rodent_blocks)
# ---- 3) EPIESTIM ----
ebola_epiestim <- ebola_daily_incidence %>% rename(I = cases)
Tmax <- nrow(ebola_epiestim)
# sliding windows (7-day)
t_start_sl <- seq(2, Tmax - 6)
t_end_sl   <- t_start_sl + 6
res_sliding <- estimate_R(
incid  = ebola_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 14.2, std_si = 9.6,
t_start = t_start_sl, t_end = t_end_sl
))
)
# PLOT 4: EpiEstim sliding
