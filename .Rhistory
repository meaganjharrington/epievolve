library(dplyr)
library(ggplot2)
library(patchwork)
# ---- 1) Inputs ----
beta_td <- out_ebola$posterior_paths$beta      # daily β draws: matrix
starts  <- out_ebola$blocks$beta_starts        # e.g., c(1, 100, 180, 240)
ends    <- out_ebola$blocks$beta_ends          # e.g., c(99, 179, 239, 480)
# ---- 2) Ensure orientation is rows=time (T), cols=draws (D) ----
stopifnot(!is.null(dim(beta_td)))
T_target <- max(ends)
if (nrow(beta_td) == T_target) {
beta_TD <- beta_td
} else if (ncol(beta_td) == T_target) {
beta_TD <- t(beta_td)
} else {
stop(sprintf(
"posterior_paths$beta dims %s don't match max(ends)=%d",
paste(dim(beta_td), collapse = "x"), T_target
))
}
T_len <- nrow(beta_TD)
D_use <- ncol(beta_TD)
# Clip blocks to horizon (safety)
keep   <- starts <= T_len
starts <- pmax(starts[keep], 1L)
ends   <- pmin(ends[keep],   T_len)
K      <- length(starts)
# ---- 3) Reconstruct block-level draws: K x D ----
# For each block, average β over its time rows for each draw (column)
beta_blocks_samp <- sapply(seq_len(K), function(k) {
rows <- starts[k]:ends[k]
colMeans(beta_TD[rows, , drop = FALSE], na.rm = TRUE)
})
beta_blocks_samp <- t(beta_blocks_samp)  # D x K -> K x D
# ---- 4) Summarise across draws per block (median & 95% CI) ----
beta_block_summ <- tibble(
t_start = starts,
t_end   = ends,
median  = apply(beta_blocks_samp, 1, median,   na.rm = TRUE),
lower   = apply(beta_blocks_samp, 1, quantile, probs = 0.025, na.rm = TRUE),
upper   = apply(beta_blocks_samp, 1, quantile, probs = 0.975, na.rm = TRUE)
)
# Geometries for block step plot
beta_rect <- beta_block_summ %>%
transmute(xmin = t_start, xmax = t_end, ymin = lower, ymax = upper, id = row_number())
beta_seg <- beta_block_summ %>%
transmute(x = t_start, xend = t_end, y = median, yend = median, id = row_number())
# ---- 5) β(t) panel: block ribbons + median steps (no gridlines) ----
p_beta_blocks <- ggplot() +
geom_rect(
data = beta_rect,
aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, group = id),
fill = "#6A51A3", alpha = 0.15, color = NA
) +
geom_segment(
data = beta_seg,
aes(x = x, xend = xend, y = y, yend = yend, group = id),
color = "#6A51A3", linewidth = 0.9, lineend = "butt"
) +
geom_vline(xintercept = ebola_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(
title = "rodent: β(t) — blockwise",
subtitle = "Posterior median and 95% credible intervals by block",
x = "Time (days)", y = expression(beta(t))
) +
theme_minimal(base_size = 11) +
theme(panel.grid = element_blank())
# ---- 6) S(t) panel (same styling) ---
p_S <- plot_S_trajectory(out_ebola, N = 8600000,
title_label = "Ebola Sierra Leone") +
geom_vline(xintercept = ebola_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(title = "S(t): Susceptible over time",
subtitle = NULL, x = "Time (days)", y = "Susceptible (S)") +
theme_minimal(base_size = 11) +
theme(panel.grid = element_blank())
# ---- 7) Stack them (β top, S bottom) ----
beta_S_stack <- p_beta_blocks / p_S +
plot_annotation(
title = "Ebola Sierra Leone 2014 — β(t) blocks and S(t)",
subtitle = "Top: β(t) block medians with 95% CI | Bottom: S(t) trajectory",
theme = theme(
plot.title = element_text(size = 14, face = "bold"),
plot.subtitle = element_text(size = 9, color = "grey40")
)
)
print(beta_S_stack)
library(ggplot2)
library(patchwork)
library(EpiEstim)
library(dplyr)
# --- inputs assumed already created ---
# out_flu, flu_vlines, Tmax_flu
# flu_daily_incid (time, cases)
# --- Panel A: rodent smooth Rt(t) for FLU ---
p_rodent_flu <- out_flu$Rt_plot +
geom_vline(xintercept = flu_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
geom_hline(yintercept = 1, linetype = 2, color = "black") +
labs(
title = "rodent: Rt(t)",
subtitle = "Piecewise β, 95% CI",
x = "Time (days)", y = "Rt"
) +
theme_minimal(base_size = 11) +
theme(panel.grid = element_blank()) +
scale_y_continuous(limits = c(0, 5))
# --- Panel B: EpiEstim (14-day sliding window) for FLU ---
flu_epiestim <- flu_daily_incid %>% rename(I = cases)
res_sliding_flu <- estimate_R(
incid  = flu_epiestim,
method = "parametric_si",
config = make_config(list(
mean_si = 2.6, std_si = 1.5,
t_start = seq(2, Tmax_flu - 13),
t_end   = seq(2, Tmax_flu - 13) + 13
))
)
p_epi_14_flu <- plot(res_sliding_flu_14d, "R") +
geom_hline(yintercept = 1, linetype = 2, color = "black") +
geom_vline(xintercept = flu_vlines, linetype = "dotted",
color = "darkgrey", linewidth = 0.6) +
labs(
title = "EpiEstim: 7-day windows",
x = "Time (days)", y = "Rt"
) +
theme_minimal(base_size = 11) +
theme(panel.grid = element_blank()) +
scale_y_continuous(limits = c(0, 5))
