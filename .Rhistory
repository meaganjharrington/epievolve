dir.create("figures", showWarnings = FALSE)
save_fig <- function(plot_obj, filename, w = 7, h = 5) {
ggsave(
filename = file.path("figures", filename),
plot     = plot_obj,
width    = w,
height   = h,
dpi      = 400,
bg       = "white"
)
}
